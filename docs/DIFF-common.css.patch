--- common-batch2.css
+++ common-batch3.css
@@ -2073,3 +2073,234 @@
 body.edu-page-ea4,body.edu-page-gt1{--edu-calc-max-width:1060px;--edu-calc-sidebar-width:330px;--purple:#6941c6;--purple-soft:#f1edff}
 body.edu-page-ea1 .warning,body.edu-page-ea2 .warning,body.edu-page-ea4 .warning,body.edu-page-gt1 .warning{background:var(--red-soft)!important;color:var(--red)!important;border:1px solid var(--edu-danger-border)!important}
 
+
+
+/* ==========================================================================
+   v3.20.9-b3 — CSS consolidation batch 3
+   ========================================================================== */
+
+/* --------------------------------------------------------------------------
+   SDE secondment calculator — variant of the shared SDE calculator family
+   -------------------------------------------------------------------------- */
+body.edu-ui.edu-calc-sde.edu-page-sde-apospasis{
+  --sde-page-max:1200px;
+  --sde-sidebar:350px;
+  --sde:#18794e;
+  --sde-dark:#12633f;
+  --sde-soft:#eaf7f0;
+  --sde-hero:linear-gradient(135deg,#214d3b 0%,#18794e 58%,#2e9b6c 100%);
+  --sde-total-size:56px;
+}
+body.edu-ui.edu-page-sde-apospasis .hero p{max-width:930px}
+body.edu-ui.edu-page-sde-apospasis .hero-meta span{background:rgba(0,0,0,.15)}
+body.edu-ui.edu-page-sde-apospasis .success{border-color:#b7e3c9;color:#12633f}
+body.edu-ui.edu-page-sde-apospasis .sde-update-banner{margin:0 0 18px}
+body.edu-ui.edu-page-sde-apospasis .sde-language-level{margin-top:8px}
+body.edu-ui.edu-page-sde-apospasis .assignment{
+  padding:11px 12px;border:1px solid #d8e8df;border-radius:11px;margin-top:8px;background:#f8fcfa
+}
+body.edu-ui.edu-page-sde-apospasis .assignment strong{color:#12633f}
+body.edu-ui.edu-page-sde-apospasis .assignment small{display:block;color:var(--muted);margin-top:3px}
+body.edu-ui.edu-page-sde-apospasis .assignment .badge{
+  display:inline-block;padding:3px 7px;border-radius:999px;background:var(--sde-soft);
+  color:var(--sde);font-size:11px;font-weight:700;margin-left:6px
+}
+body.edu-ui.edu-page-sde-apospasis .mapping-wrap{overflow-x:auto;margin-top:12px;max-width:100%}
+body.edu-ui.edu-page-sde-apospasis .mapping-table{
+  width:100%;border-collapse:collapse;font-size:13.5px;min-width:620px
+}
+body.edu-ui.edu-page-sde-apospasis .mapping-table th,
+body.edu-ui.edu-page-sde-apospasis .mapping-table td{
+  border:1px solid #dfe5ec;padding:9px 10px;text-align:left;vertical-align:top
+}
+body.edu-ui.edu-page-sde-apospasis .mapping-table th{background:#eef4ff;color:#174ea6}
+body.edu-ui.edu-page-sde-apospasis .mapping-table tr:nth-child(even) td{background:#fbfcfe}
+
+/* --------------------------------------------------------------------------
+   Main tools directory
+   -------------------------------------------------------------------------- */
+body.edu-ui.edu-tools-directory{
+  --bg:#f4f7fb;--card:#fff;--text:#18202b;--muted:#5f6b7a;--border:#dfe5ec;
+  --blue:#1f6feb;--blue-dark:#174ea6;--blue-soft:#eef4ff;--green:#18794e;
+  --green-soft:#eaf7f0;--purple:#6941c6;--purple-soft:#f1edff;
+  --orange:#b45309;--orange-soft:#fff4e5;--shadow:0 10px 30px rgba(28,39,55,.09);
+  font-family:Arial,Helvetica,sans-serif;background:var(--bg);margin:0;color:var(--text);line-height:1.55
+}
+body.edu-ui.edu-tools-directory .page-shell{max-width:1180px;margin:0 auto;padding:34px 22px 50px;min-width:0}
+body.edu-ui.edu-tools-directory .hero{
+  position:relative;overflow:hidden;background:linear-gradient(135deg,#174ea6 0%,#1f6feb 58%,#3b82f6 100%);
+  color:#fff;border-radius:22px;padding:42px 36px;box-shadow:var(--shadow)
+}
+body.edu-ui.edu-tools-directory .hero::after{
+  content:"";position:absolute;width:260px;height:260px;border-radius:50%;
+  background:rgba(255,255,255,.08);right:-70px;top:-100px
+}
+body.edu-ui.edu-tools-directory .hero-kicker{
+  position:relative;z-index:1;display:inline-block;padding:6px 11px;margin-bottom:13px;border-radius:999px;
+  background:rgba(255,255,255,.14);border:1px solid rgba(255,255,255,.22);
+  font-size:13px;font-weight:700;letter-spacing:.02em
+}
+body.edu-ui.edu-tools-directory .hero h1{
+  position:relative;z-index:1;margin:0 0 12px;font-size:clamp(30px,5vw,44px);line-height:1.12;color:#fff
+}
+body.edu-ui.edu-tools-directory .hero p{
+  position:relative;z-index:1;margin:0;max-width:800px;color:rgba(255,255,255,.92);font-size:17px
+}
+body.edu-ui.edu-tools-directory .hero-meta{
+  position:relative;z-index:1;display:flex;gap:10px;flex-wrap:wrap;margin-top:22px
+}
+body.edu-ui.edu-tools-directory .hero-meta span{
+  padding:7px 11px;border-radius:9px;background:rgba(0,0,0,.12);font-size:13px;font-weight:700
+}
+body.edu-ui.edu-tools-directory .toolbar{
+  margin-top:24px;background:var(--card);border:1px solid var(--border);border-radius:18px;
+  padding:18px;box-shadow:0 4px 18px rgba(28,39,55,.05)
+}
+body.edu-ui.edu-tools-directory .search-wrap{position:relative}
+body.edu-ui.edu-tools-directory .search-wrap::before{
+  content:"🔎";position:absolute;left:15px;top:50%;transform:translateY(-50%);
+  font-size:16px;pointer-events:none
+}
+body.edu-ui.edu-tools-directory #toolSearch{
+  width:100%;border:1px solid #cfd7e2;border-radius:12px;padding:14px 14px 14px 45px;
+  font-size:16px;outline:none;background:#fbfcfe;color:var(--text);
+  transition:border-color .15s ease,box-shadow .15s ease
+}
+body.edu-ui.edu-tools-directory #toolSearch:focus{
+  border-color:var(--blue);box-shadow:0 0 0 3px rgba(31,111,235,.12)
+}
+body.edu-ui.edu-tools-directory .filters{display:flex;gap:9px;flex-wrap:wrap;margin-top:14px}
+body.edu-ui.edu-tools-directory .filter-btn{
+  appearance:none;border:1px solid #d4dbe5;background:#fff;color:#465262;border-radius:999px;
+  padding:8px 13px;font-size:14px;font-weight:700;cursor:pointer;transition:all .15s ease
+}
+body.edu-ui.edu-tools-directory .filter-btn:hover,
+body.edu-ui.edu-tools-directory .filter-btn.active{
+  color:#fff;background:var(--blue);border-color:var(--blue)
+}
+body.edu-ui.edu-tools-directory .results-line{margin:17px 2px 0;color:var(--muted);font-size:14px}
+body.edu-ui.edu-tools-directory .tools-grid{
+  display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18px;margin-top:18px
+}
+body.edu-ui.edu-tools-directory .tool-card{
+  position:relative;display:flex;flex-direction:column;min-width:0;min-height:265px;
+  text-decoration:none;color:inherit;background:var(--card);border:1px solid var(--border);
+  border-radius:17px;padding:20px;box-shadow:0 4px 16px rgba(28,39,55,.05);
+  transition:transform .16s ease,box-shadow .16s ease,border-color .16s ease
+}
+body.edu-ui.edu-tools-directory .tool-card:hover{
+  transform:translateY(-4px);box-shadow:0 12px 28px rgba(28,39,55,.12);border-color:#a8c7fa
+}
+body.edu-ui.edu-tools-directory .card-top{
+  display:flex;align-items:center;justify-content:space-between;gap:10px;margin-bottom:15px
+}
+body.edu-ui.edu-tools-directory .tool-number{
+  display:inline-flex;align-items:center;justify-content:center;min-width:38px;height:32px;
+  padding:0 10px;background:var(--blue);color:#fff;font-weight:700;border-radius:999px;font-size:13px
+}
+body.edu-ui.edu-tools-directory .category-tag{
+  display:inline-block;padding:5px 9px;border-radius:999px;font-size:12px;font-weight:700;
+  background:var(--blue-soft);color:var(--blue-dark)
+}
+body.edu-ui.edu-tools-directory .category-tag.green{background:var(--green-soft);color:var(--green)}
+body.edu-ui.edu-tools-directory .category-tag.purple{background:var(--purple-soft);color:var(--purple)}
+body.edu-ui.edu-tools-directory .category-tag.orange{background:var(--orange-soft);color:var(--orange)}
+body.edu-ui.edu-tools-directory .new-badge{
+  position:absolute;right:18px;top:-10px;padding:5px 9px;border-radius:999px;
+  background:#137333;color:#fff;font-size:11px;font-weight:700;box-shadow:0 3px 8px rgba(0,0,0,.12)
+}
+body.edu-ui.edu-tools-directory .tool-card h2{font-size:20px;line-height:1.3;margin:0 0 10px}
+body.edu-ui.edu-tools-directory .tool-card p{color:var(--muted);font-size:14.5px;margin:0 0 18px}
+body.edu-ui.edu-tools-directory .tool-card .button-like{
+  margin-top:auto;color:var(--blue);font-size:14.5px;font-weight:700
+}
+body.edu-ui.edu-tools-directory .no-results{
+  display:none;margin-top:18px;padding:24px;text-align:center;color:var(--muted);
+  background:#fff;border:1px dashed #cfd7e2;border-radius:14px
+}
+body.edu-ui.edu-tools-directory .info-grid{
+  display:grid;grid-template-columns:1.15fr .85fr;gap:18px;margin-top:26px
+}
+body.edu-ui.edu-tools-directory .notice,
+body.edu-ui.edu-tools-directory .side-box{
+  padding:18px;border-radius:14px;line-height:1.6;font-size:14.5px
+}
+body.edu-ui.edu-tools-directory .notice{
+  background:var(--orange-soft);color:#7b4900;border:1px solid #f0d4a8
+}
+body.edu-ui.edu-tools-directory .notice strong{color:#633b00}
+body.edu-ui.edu-tools-directory .side-box{
+  background:var(--blue-soft);color:var(--blue-dark);border:1px solid #d6e4ff
+}
+body.edu-ui.edu-tools-directory .side-box strong{display:block;margin-bottom:5px}
+body.edu-ui.edu-tools-directory .side-box a{color:var(--blue);font-weight:700}
+body.edu-ui.edu-tools-directory .credits{text-align:center;margin-top:27px;color:#7a8490;font-size:13px}
+body.edu-ui.edu-tools-directory .hidden-card{display:none!important}
+@media(max-width:900px){
+  body.edu-ui.edu-tools-directory .tools-grid{grid-template-columns:repeat(2,minmax(0,1fr))}
+  body.edu-ui.edu-tools-directory .info-grid{grid-template-columns:1fr}
+}
+@media(max-width:620px){
+  body.edu-ui.edu-tools-directory .page-shell{padding:18px 13px 35px}
+  body.edu-ui.edu-tools-directory .hero{padding:30px 22px;border-radius:17px}
+  body.edu-ui.edu-tools-directory .hero p{font-size:15px}
+  body.edu-ui.edu-tools-directory .tools-grid{grid-template-columns:1fr}
+  body.edu-ui.edu-tools-directory .tool-card{min-height:230px}
+  body.edu-ui.edu-tools-directory .toolbar{padding:14px}
+}
+
+/* --------------------------------------------------------------------------
+   ASEP mini tools hub
+   -------------------------------------------------------------------------- */
+body.edu-ui.edu-asep-tools-hub{
+  font-family:Arial,sans-serif;background:#f5f5f5;margin:0;padding:30px;color:#222
+}
+body.edu-ui.edu-asep-tools-hub .page-box{
+  max-width:980px;margin:auto;background:#fff;padding:28px;border-radius:16px;
+  box-shadow:0 4px 14px rgba(0,0,0,.12);min-width:0
+}
+body.edu-ui.edu-asep-tools-hub h1{
+  text-align:center;font-size:28px;margin-bottom:10px;line-height:1.25
+}
+body.edu-ui.edu-asep-tools-hub .intro{
+  text-align:center;color:#555;font-size:16px;line-height:1.55;max-width:760px;margin:0 auto 28px
+}
+body.edu-ui.edu-asep-tools-hub .tools-grid{
+  display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:18px;margin-top:24px
+}
+body.edu-ui.edu-asep-tools-hub .tool-card{
+  display:block;min-width:0;text-decoration:none;color:inherit;background:#fafafa;border:1px solid #ddd;
+  border-radius:14px;padding:20px;transition:transform .15s ease,box-shadow .15s ease,border-color .15s ease;
+  min-height:210px
+}
+body.edu-ui.edu-asep-tools-hub .tool-card:hover{
+  transform:translateY(-3px);box-shadow:0 6px 18px rgba(0,0,0,.14);border-color:#1f6feb
+}
+body.edu-ui.edu-asep-tools-hub .tool-number{
+  display:inline-block;background:#1f6feb;color:#fff;font-weight:700;padding:6px 10px;
+  border-radius:999px;font-size:14px;margin-bottom:12px
+}
+body.edu-ui.edu-asep-tools-hub .tool-card h2{font-size:20px;margin:0 0 10px;line-height:1.3}
+body.edu-ui.edu-asep-tools-hub .tool-card p{color:#555;font-size:15px;line-height:1.5;margin:0 0 14px}
+body.edu-ui.edu-asep-tools-hub .tool-card .button-like{
+  display:inline-block;margin-top:8px;color:#1f6feb;font-weight:700;font-size:15px
+}
+body.edu-ui.edu-asep-tools-hub .notice{
+  margin-top:28px;padding:16px;border-radius:10px;background:#fff4e5;color:#8a5300;
+  line-height:1.55;font-size:15px
+}
+body.edu-ui.edu-asep-tools-hub .notice strong{color:#6f4300}
+body.edu-ui.edu-asep-tools-hub .quick-links{
+  margin-top:24px;padding:16px;border-radius:10px;background:#eef4ff;color:#174ea6;line-height:1.6
+}
+body.edu-ui.edu-asep-tools-hub .quick-links h2{margin-top:0;font-size:18px}
+body.edu-ui.edu-asep-tools-hub .quick-links a{color:#1f6feb;font-weight:700;word-break:break-word}
+body.edu-ui.edu-asep-tools-hub .credits{
+  margin-top:26px;text-align:center;font-size:13px;color:#777
+}
+@media(max-width:850px){
+  body.edu-ui.edu-asep-tools-hub .tools-grid{grid-template-columns:1fr}
+  body.edu-ui.edu-asep-tools-hub{padding:18px}
+  body.edu-ui.edu-asep-tools-hub .page-box{padding:22px}
+  body.edu-ui.edu-asep-tools-hub h1{font-size:24px}
+}
